# Resend server key. Never expose this to browser code.
RESEND_API_KEY=re_xxxxxxxxx

# Signing secret for POST /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# JSON object mapping each LVL Mail application id to its private gateway key.
# Generate long random values for production.
LVL_MAIL_APP_KEYS={"lvltech":"replace-me","nexmesa":"replace-me","finlab":"replace-me","cody":"replace-me"}

# Domain verified in Resend.
LVL_MAIL_SENDING_DOMAIN=mail.lvltechmx.com

# Server-only Supabase credentials used for observability, suppressions and metrics.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Protects the administrative control plane in production using HTTP Basic Auth.
# Use long, unique credentials and only serve the site over HTTPS.
LVL_MAIL_ADMIN_USER=admin
LVL_MAIL_ADMIN_PASSWORD=replace-with-a-long-random-password

# Delivery provider selected by LVL Mail. Calling applications never depend on it.
# LVL_MAIL_PROVIDER remains as a backwards-compatible alias for the primary slot.
LVL_MAIL_PROVIDER=resend
LVL_MAIL_PRIMARY_PROVIDER=resend

# Optional secondary slot. Keep failover disabled until a genuinely independent
# provider adapter and credentials are configured. LVL Mail never auto-fails over
# ambiguous transport errors because cross-provider idempotency cannot prevent duplicates.
LVL_MAIL_SECONDARY_PROVIDER=
LVL_MAIL_FAILOVER_MODE=disabled

# Resend server key for the current provider adapter. Never expose this to browser code.
RESEND_API_KEY=re_xxxxxxxxx

# Signing secret for POST /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Optional legacy keys for the original built-in apps while migrating to the
# database-backed app registry. Newly added webs receive hashed DB-backed keys.
LVL_MAIL_APP_KEYS={"lvltech":"replace-me","nexmesa":"replace-me","finlab":"replace-me","cody":"replace-me"}

# Domain verified with the active provider. Every connected web sends through this domain.
LVL_MAIL_SENDING_DOMAIN=mail.lvltechmx.com

# Supabase project used by LVL Mail. The publishable key is intentionally public
# and is used only for staff Auth/session verification. The service-role key is
# server-only and must never use NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# 32 random bytes encoded as base64. Used only to encrypt short-lived recovery
# envelopes for approved non-critical templates. Never use NEXT_PUBLIC_.
LVL_MAIL_RECOVERY_KEY=replace-with-32-byte-base64-key

# 32 random bytes encoded as base64. Encrypts external alert webhook endpoints
# and per-channel signing secrets at rest. In-app alerting does not require this.
LVL_MAIL_ALERT_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Dedicated Bearer secret for POST /api/internal/alerts/dispatch. Keep separate
# from the reliability sweep secret so either scheduler capability can be revoked independently.
LVL_MAIL_ALERT_DISPATCH_SECRET=replace-with-an-independent-long-random-secret

# Dedicated Bearer secret for POST /api/internal/maintenance/purge. Daily retention
# maintenance should use a separate secret so cleanup can be revoked independently.
LVL_MAIL_MAINTENANCE_SECRET=replace-with-an-independent-long-random-secret

# Temporary emergency access while Supabase IAM is being rolled out. Keep these
# credentials independent from all other secrets. Once IAM is validated in
# production set LVL_MAIL_BREAK_GLASS_ENABLED=false.
LVL_MAIL_BREAK_GLASS_ENABLED=true
LVL_MAIL_ADMIN_USER=admin
LVL_MAIL_ADMIN_PASSWORD=replace-with-a-long-random-password

# Bearer secret for POST /api/internal/reliability/sweep.
# Configure a scheduler only after production persistence is connected.
LVL_MAIL_CRON_SECRET=replace-with-an-independent-long-random-secret

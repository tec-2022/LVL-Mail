# Delivery provider selected by LVL Mail. Calling applications never depend on it.
LVL_MAIL_PROVIDER=resend

# Resend server key for the current provider adapter. Never expose this to browser code.
RESEND_API_KEY=re_xxxxxxxxx

# Signing secret for POST /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Optional legacy keys for the original built-in apps while migrating to the
# database-backed app registry. Newly added webs receive hashed DB-backed keys.
LVL_MAIL_APP_KEYS={"lvltech":"replace-me","nexmesa":"replace-me","finlab":"replace-me","cody":"replace-me"}

# Domain verified with the active provider. Every connected web sends through this domain.
LVL_MAIL_SENDING_DOMAIN=mail.lvltechmx.com

# Server-only Supabase credentials used for the application registry,
# hashed app keys, mandatory tracking, policies, quotas, audit and metrics.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Protects the administrative control plane and application onboarding in production.
# Use long, unique credentials and only serve the site over HTTPS.
LVL_MAIL_ADMIN_USER=admin
LVL_MAIL_ADMIN_PASSWORD=replace-with-a-long-random-password
